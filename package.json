{
  "name": "react-express-pre-render",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "debug-vite-build": "node --inspect-brk ./node_modules/vite/bin/vite.js build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc",
    "start": "npm-run-all -s build:tsc build:vite copy-html -p start:server start:watch:tsc start:watch:vite copy-html:watch",
    "build": "npm-run-all -s build:tsc build:vite copy-html",
    "build:tsc": "tsc -b",
    "build:vite": "vite build",
    "copy-html": "mkdir -p dist && cp build/client/__spa-fallback.html dist/",
    "copy-html:watch": "wait-on build/client/__spa-fallback.html && copy-html",
    "start:server": "nodemon dist/server.js",
    "start:watch:tsc": "tsc -w",
    "start:watch:vite": "vite build --watch"
  },
  "dependencies": {
    "@types/express": "^5.0.1",
    "express": "^5.1.0",
    "isbot": "^5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@react-router/dev": "^7.5.0",
    "@react-router/node": "^7.5.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1"
  }
}
