{
  "name": "react-express-pre-render",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "debug-vite-build": "node --inspect-brk ./node_modules/vite/bin/vite.js build --watch",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc",
    "start": "npm-run-all -s build -p start:watch:tsc start:watch:vite start:server start:browser-sync",
    "build": "npm-run-all -s build:tsc build:vite copy-html",
    "build:tsc": "tsc -b",
    "build:vite": "vite build",
    "copy-html": "mkdir -p dist && cp build/client/__spa-fallback.html dist/",
    "start:server": "PORT=3001 nodemon dist/server.js",
    "start:watch:tsc": "tsc -w -p tsconfig.node.json",
    "start:watch:vite": "nodemon --watch src --ext ts,tsx,css,json --exec \"npm run build:vite\"",
    "start:browser-sync": "browser-sync start --proxy 'localhost:3001' --port 3000 --ui-port 3002 --files 'build/client/**/*' --no-notify --open --snippetOptions.ignorePaths='localhost:3001'"
  },
  "dependencies": {
    "@types/express": "^5.0.1",
    "express": "^5.1.0",
    "isbot": "^5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@react-router/dev": "^7.5.0",
    "@react-router/node": "^7.5.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "browser-sync": "^3.0.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "wait-on": "^6.0.1"
  }
}
